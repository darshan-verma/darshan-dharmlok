// Prisma Schema for MongoDB
datasource db {
    provider = "mongodb"
    url = env("MONGODB_URI")
}
// Generator for Prisma Client
generator client {
    provider = "prisma-client-js"
    database = "mongoDb"
}
// User Model
model User {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    name String
    phone String
    email String @unique
    bio String?
    userType String?
    typeVendor String?
    profileImageUrl String?
    description String?
    coverImageUrl String?
    category String?
    password String
    social Int?
    active Int?
    rank String?
    availability Int?
    kycApproved Int?
    status String? @default("Active")
    isLoggedIn Boolean @default(false)
    lastLogoutAt DateTime?
    lastActiveAt DateTime?
    lastLoginAt DateTime?
    createdAt DateTime @default(now())
    addresses Address[]
    serviceOfferings ServiceOffering[] @relation("UserToServiceOffering")
}
// Address Model
model Address {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    user       User     @relation(fields: [userId], references: [id])
    userId     String   @db.ObjectId
    
    type       String   // e.g. "home", "work", or "other"
    label      String?  // optional custom label if type == "other"
    line1      String
    line2      String?  // suite, apt, etc.
    city       String
    state      String?
    country    String
    pincode    String?

    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

@@index([userId])
}
//Bal Vidhya Model
model BalVidhya {
    id            String               @id @default(auto()) @map("_id") @db.ObjectId
    name          String
    description   String?
    type          BalVidhyaType
    trendingStatus BalVidhyaTrendingStatus @default(NotTrending)
    category      BalVidhyaCategory?
    url           String?
    thumbnailUrl  String?
    videoUrl      String?
    videoFile     String?
    bookFile      String?
    status        BalVidhyaStatus       @default(Active)
    approved      Boolean
    createdAt     DateTime              @default(now())
    updatedAt     DateTime              @updatedAt
}
enum BalVidhyaType {
    video
    book
}
enum BalVidhyaStatus {
    Active
    Inactive
}
enum BalVidhyaCategory {
    BhagavadGita
    Ramayana
    Mahabharata
    Vedas
    Puranas
    Upanishads
    BhaktiYoga
    Other
}
enum BalVidhyaTrendingStatus {
    NotTrending
    Trending
    HighlyTrending
    Seasonal
    Featured
}
// Pooja Category Model
model PoojaCategory {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    description String?
    date        DateTime?
    price       Float?
    status      String? @default("Active")
    details     String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}
// Service Offering Model
model ServiceOffering {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    provider     User     @relation("UserToServiceOffering", fields: [providerId], references: [id])
    providerId   String   @db.ObjectId

    serviceType  String   // e.g. "pooja", "consultation", "event", etc.
    targetType   String   // e.g. "PoojaCategory", "Event", etc.
    targetId     String   // e.g. poojaCategoryId, eventId, etc.

    price        Float
    details      String?
    metadata     Json?

    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    status       String? @default("Active")
} 
// EBook Model
model EBook {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    date        DateTime @default(now())
    description String
    type        String   // e.g. "pdf", "epub", or your own categories
    category    String   // e.g. "spiritual", "mythology", etc.
    detail      String?  // for full content, summary, or download URL
    status       String? @default("Active")
    bookFile      String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}
// Quote Model
model Quote {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    quote     String
    date      DateTime @default(now())
    status    String   // e.g. "active", "inactive"
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
// Banner Model
model Banner {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    date        DateTime @default(now())
    description String
    category    String
    type        String   // e.g. "image", "video", "promo", etc.
    imageUrl    String?  // URL/path to the banner file (image, video, etc.)
    bannerFile     String?  // optional file path if type == "video"
    status      String   // e.g. "active", "inactive", "draft"
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}