// Prisma Schema for MongoDB
datasource db {
    provider = "mongodb"
    url = env("MONGODB_URI")
}
// Generator for Prisma Client
generator client {
    provider = "prisma-client-js"
    database = "mongoDb"
}
// User Model
model User {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    name String
    phone String
    email String @unique
    bio String?
    userType String?
    typeVendor String?
    profileImageUrl String?
    description String?
    coverImageUrl String?
    category String?
    password String
    social Int?
    active Int?
    rank String?
    availability Int?
    kycApproved Int?
    status String? @default("Active")
    isLoggedIn Boolean @default(false)
    lastLogoutAt DateTime?
    lastActiveAt DateTime?
    lastLoginAt DateTime?
    createdAt DateTime @default(now())
    addresses Address[]
}
// Address Model
model Address {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    user       User     @relation(fields: [userId], references: [id])
    userId     String   @db.ObjectId
    
    type       String   // e.g. "home", "work", or "other"
    label      String?  // optional custom label if type == "other"
    line1      String
    line2      String?  // suite, apt, etc.
    city       String
    state      String?
    country    String
    pincode    String?

    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

@@index([userId])
}
//Bal Vidhya Model
model BalVidhya {
    id            String               @id @default(auto()) @map("_id") @db.ObjectId
    name          String
    description   String?
    type          BalVidhyaType
    trendingStatus BalVidhyaTrendingStatus @default(NotTrending)
    category      BalVidhyaCategory?
    url           String?
    thumbnailUrl  String?
    status        BalVidhyaStatus       @default(Active)
    approved      Boolean
    createdAt     DateTime              @default(now())
    updatedAt     DateTime              @updatedAt
}
enum BalVidhyaType {
    video
    book
}
enum BalVidhyaStatus {
    Active
    Inactive
}
enum BalVidhyaCategory {
    BhagavadGita
    Ramayana
    Mahabharata
    Vedas
    Puranas
    Upanishads
    BhaktiYoga
    Other
}
enum BalVidhyaTrendingStatus {
    NotTrending
    Trending
    HighlyTrending
    Seasonal
    Featured
}
