datasource db {
    provider = "mongodb"
    url = env("MONGODB_URI")
}
generator client {
    provider = "prisma-client-js"
    database = "mongoDb"
}
model User {
    id String @id @default(auto()) @map("_id") @db.ObjectId
    name String
    phone String
    email String @unique
    bio String?
    userType String?
    typeVendor String?
    profileImageUrl String?
    description String?
    coverImageUrl String?
    category String?
    password String
    social Int?
    active Int?
    rank Int?
    availability Int?
    kycApproved Int?
    status String? @default("Active")
    isLoggedIn Boolean @default(false)
    lastLogoutAt DateTime?
    lastActiveAt DateTime?
    lastLoginAt DateTime?
    createdAt DateTime @default(now())
    addresses Address[]
}

model Address {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    user       User     @relation(fields: [userId], references: [id])
    userId     String   @db.ObjectId
    
    type       String   // e.g. "home", "work", or "other"
    label      String?  // optional custom label if type == "other"
    line1      String
    line2      String?  // suite, apt, etc.
    city       String
    state      String?
    country    String
    pincode    String?

    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

@@index([userId])
}