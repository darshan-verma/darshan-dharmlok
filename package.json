{
  "name": "dharmlok-next-js",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "uat:run": "node scripts/tripjack-uat-runner.mjs",
    "uat:report": "node scripts/generate-uat-report.mjs && node scripts/split-uat-segregated-logs.mjs",
    "uat:split-logs": "node scripts/split-uat-segregated-logs.mjs",
    "uat:export-segregated": "node scripts/export-tripjack-segregated-logs.mjs",
    "uat:export": "node scripts/tripjack-export-segregated.mjs",
    "uat:enrich-amendment": "node scripts/uat-enrich-amendment-logs.mjs && npm run uat:split-logs",
    "uat:book-matrix": "node scripts/tripjack-uat-runner.mjs --book-flow-matrix --patch",
    "uat:complete-matrix": "node scripts/tripjack-uat-runner.mjs --book-flow-matrix --patch && node scripts/tripjack-export-segregated.mjs && cd docs && zip -r TRIPJACK-UAT-CERTIFICATION-JSON.zip TRIPJACK-UAT-CERTIFICATION-JSON",
    "uat:full": "npm run uat:book-matrix && npm run uat:export",
    "uat:zip": "cd docs && zip -r TRIPJACK-UAT-CERTIFICATION-JSON.zip TRIPJACK-UAT-CERTIFICATION-JSON && echo 'Zip created'",
    "uat:submit": "npm run uat:full && npm run uat:zip",
    "uat": "npm run uat:run && npm run uat:report",
    "uat:book": "node scripts/tripjack-uat-runner.mjs --book-flow && npm run uat:report",
    "uat:book-cert": "node scripts/tripjack-uat-runner.mjs --book-flow --patch --only CERT-PUBLISHED,CERT-SPECIAL-RETURN,CERT-PASSPORT,CERT-GST,CERT-NO-GST,CERT-SSR,CERT-STUDENT,CERT-SENIOR && npm run uat:report",
    "uat:patch": "node scripts/tripjack-uat-runner.mjs --patch && npm run uat:report",
    "uat:only": "node scripts/tripjack-uat-runner.mjs --only",
    "tbo:run": "node scripts/tbo-uat-runner.mjs",
    "tbo:run:mandatory": "node scripts/tbo-uat-runner.mjs --mandatory-only",
    "tbo:run:fresh": "node scripts/tbo-uat-runner.mjs --fresh",
    "tbo:run:mandatory:fresh": "node scripts/tbo-uat-runner.mjs --mandatory-only --fresh",
    "tbo:report": "node scripts/tbo-generate-uat-report.mjs && node scripts/export-tbo-segregated-logs.mjs && node scripts/tbo-export-certification-submit.mjs",
    "tbo:export-segregated": "node scripts/export-tbo-segregated-logs.mjs",
    "tbo:export-submit": "node scripts/tbo-export-certification-submit.mjs",
    "tbo:uat": "npm run tbo:run && npm run tbo:report",
    "tbo:uat:mandatory": "npm run tbo:run:mandatory && npm run tbo:report",
    "tbo:patch": "node scripts/tbo-uat-runner.mjs --patch && npm run tbo:report",
    "tbo:only": "node scripts/tbo-uat-runner.mjs --only",
    "tbo:sample": "node scripts/tbo-uat-runner.mjs --only CASE-SAMPLE",
    "tbo:sample:export": "node scripts/tbo-export-sample-email.mjs",
    "tbo:split-sample": "node scripts/tbo-split-sample.mjs",
    "airiq:run": "node scripts/airiq-uat-runner.mjs",
    "airiq:export": "node scripts/airiq-export-cases.mjs",
    "airiq:uat": "npm run airiq:run && npm run airiq:export",
    "airiq:patch": "node scripts/airiq-uat-runner.mjs --patch && npm run airiq:export",
    "airiq:only": "node scripts/airiq-uat-runner.mjs --only",
    "tripsafe:run": "node scripts/tripsafe-uat-runner.mjs",
    "tripsafe:export": "node scripts/tripsafe-export-cases.mjs",
    "tripsafe:uat": "npm run tripsafe:run && npm run tripsafe:export",
    "tripsafe:book": "node scripts/tripsafe-uat-runner.mjs --book-flow && npm run tripsafe:export",
    "tripsafe:patch": "node scripts/tripsafe-uat-runner.mjs --patch --book-flow && npm run tripsafe:export",
    "tripsafe:only": "node scripts/tripsafe-uat-runner.mjs --only",
    "hotel:run": "node scripts/tripjack-hotel-uat-runner.mjs",
    "hotel:export": "node scripts/tripjack-hotel-export-cases.mjs",
    "hotel:uat": "npm run hotel:run && npm run hotel:export",
    "hotel:book": "node scripts/tripjack-hotel-uat-runner.mjs --book-flow && npm run hotel:export",
    "hotel:patch": "node scripts/tripjack-hotel-uat-runner.mjs --book-flow --patch && npm run hotel:export",
    "hotel:only": "node scripts/tripjack-hotel-uat-runner.mjs --only",
    "hotel:submit": "npm run hotel:book && cd docs && zip -r TRIPJACK-HOTEL-UAT-CERTIFICATION-JSON.zip TRIPJACK-HOTEL-UAT-CASES",
    "cabs:run": "node scripts/tripjack-cabs-uat-runner.mjs",
    "cabs:export": "node scripts/tripjack-cabs-export-cases.mjs",
    "cabs:uat": "npm run cabs:run && npm run cabs:export",
    "cabs:book": "node scripts/tripjack-cabs-uat-runner.mjs --book-flow && npm run cabs:export",
    "cabs:patch": "node scripts/tripjack-cabs-uat-runner.mjs --book-flow --patch && npm run cabs:export",
    "cabs:only": "node scripts/tripjack-cabs-uat-runner.mjs --only",
    "cabs:submit": "npm run cabs:book && cd docs && zip -r TRIPJACK-CABS-UAT-CERTIFICATION-JSON.zip TRIPJACK-CABS-UAT-CASES",
    "db:backfill-lang": "node --env-file=.env scripts/backfill-content-lang.mjs",
    "db:backfill-lang:execute": "node --env-file=.env scripts/backfill-content-lang.mjs --execute",
    "db:migrate-translations": "node --env-file=.env scripts/migrate-to-translations.mjs",
    "db:migrate-translations:execute": "node --env-file=.env scripts/migrate-to-translations.mjs --execute --yes",
    "preprisma:generate": "cat prisma/models/*.prisma > prisma/schema.prisma",
    "prisma:generate": "npm run preprisma:generate && prisma generate"
  },
