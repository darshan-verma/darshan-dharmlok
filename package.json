    "next": "^15.5.9",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.0.0",
    "react-day-picker": "^9.11.2",
    "react-dom": "^19.0.0",
